# Copy this to .env and edit as needed.

# URL of the Ollama instance.
#
# Option A — all-in-one (VM + Ollama together, default profile "local"):
#   Leave this commented out; docker-compose defaults to http://ollama:11434.
#   Run with:  docker compose --profile local up --build
#
# Option B — split deployment (webserver on VM, Ollama on bare metal):
#   Set this to the bare-metal machine's LAN IP and run without --profile local:
#   Run with:  docker compose up --build
#
# OLLAMA_URL=http://192.168.1.100:11434
