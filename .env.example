# Copy this to .env and edit as needed.
#
# Local dev (no TLS):
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost
#
# Production with auto-TLS (public domain + certbot):
#   DOMAIN=example.com EMAIL=ops@example.com TLS_MODE=on \
#     docker compose --profile prod up -d

# Public hostname used by nginx and certbot.
# Set to your real domain for TLS; leave as "localhost" for local dev.
DOMAIN=localhost

# Email passed to Let's Encrypt during certificate issuance.
# Required only when TLS_MODE=on.
EMAIL=admin@localhost

# Set to "on" to enable HTTPS via certbot (requires a public DOMAIN).
# When "off" (default), nginx serves plain HTTP on port 80.
TLS_MODE=off

# URL of the Ollama instance, as seen from inside the Docker network.
# Default points at the internal `ollama` service; override if you run
# Ollama on bare metal or a remote host.
OLLAMA_URL=http://ollama:11434

# Comma-separated list of Ollama models pulled on first boot.
# Pulls are idempotent — restarts don't re-download cached weights.
# The first chat model is pre-warmed; keep nomic-embed-text (RAG embeddings).
# install.sh writes this for you; the chat-model options are:
#   best (>8GB VRAM):  hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
#   fast (~6GB VRAM):  hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
#   fastest (CPU-ok):  hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
OLLAMA_MODELS_TO_PULL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL,nomic-embed-text

# Voice (TTS): "on" runs the Kokoro sidecar (the compose `voice` profile),
# "off" runs text-only. start.sh reads this to decide the profile.
VOICE=on

# KV cache quantization (defaults set in docker-compose.yml). q8_0 halves KV
# memory at the 16k context with negligible quality loss; requires flash
# attention. Set OLLAMA_KV_CACHE_TYPE=f16 to opt out, or q4_0 to go smaller
# still (noticeable quality cost on long contexts).
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# URL of the Kokoro TTS sidecar, as seen from inside the Docker network.
KOKORO_URL=http://kokoro:8001

# Allowed CORS origin for the Kokoro FastAPI server.
# Should match the origin nginx is serving from (http://nginx internally).
CORS_ORIGIN=http://nginx
