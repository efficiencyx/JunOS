# Copy to .env. See docs/configuration.md for details.
DOMAIN=localhost

EMAIL=admin@localhost

TLS_MODE=off

AI_PROVIDER=ollama

# OpenRouter sends chat content to its cloud API.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# LLAMACPP_URL=http://llamacpp:8080
# LLAMACPP_MODEL_HF=efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M
# LLAMACPP_PORT=8081
# LLAMACPP_TOOLS=on

COMPOSE_PROFILES=ollama

OLLAMA_URL=http://ollama:11434

# JUN_PORT=8080

OLLAMA_MODELS_TO_PULL=hf.co/efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M

VOICE=on

# off lets Jun still walk out mid-scene without locking Anon out afterwards.
FLEE_BANS=on

# The voice image is CPU-only: cuda costs ~2GB VRAM for little synthesis speedup.
TTS_DEVICE=cpu

# Karaoke is a separate sidecar so it can take the GPU while voice stays on CPU.
# off leaves that container (a few GB) out of the build entirely.
KARAOKE=on

# cpu | cuda | auto - device for splitting a song into stems. Worth the VRAM
# here: minutes on CPU vs seconds on a card, and it's handed back afterwards.
SEP_DEVICE=auto

# base + empty STT_LANG = multilingual with per-utterance auto-detect.
# Use base.en + STT_LANG=en for English-only (a bit faster/sharper), or size up
# the multilingual model (small, medium, large-v3) for better non-English STT.
STT_MODEL=base
STT_LANG=

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# auto orders cards biggest-VRAM-first so the largest is device 0; a comma list
# (UUIDs or indices) picks specific cards; all leaves the driver's order alone.
# GPU_DEVICES=auto

# on splits one model across every GPU (ollama: OLLAMA_SCHED_SPREAD;
# llama.cpp on CUDA: --split-mode row). Slower per token, but fits more.
# TENSOR_PARALLEL=off

# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=5m

# Context window. Auto-detected from system RAM, which is only a proxy - VRAM is
# what bounds the KV cache. Set this by hand if the model crowds your GPU.
# OMEGA_NUM_CTX=8192

# OMEGA_STATE_DIR=/var/lib/omega
# MEMORY_DIR=/var/lib/omega/memory

# Whether accounts on this install may share their chats & usage stats to train
# better versions of Jun. This only offers the choice - each account is asked in
# the app, nothing is sent until someone opts in, and the answer is recorded per
# user. Set off to remove the option entirely. Install id comes from the installer.
TELEMETRY=on
TELEMETRY_INSTALL_ID=
# TELEMETRY_ENDPOINT=

TTS_URL=http://tts:8001
KARAOKE_URL=http://karaoke:8001

CORS_ORIGIN=http://nginx
