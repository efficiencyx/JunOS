# Copy this to .env and edit as needed.
#
# Local dev (no TLS):
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost
#
# Production with auto-TLS (public domain + certbot):
#   DOMAIN=example.com EMAIL=ops@example.com TLS_MODE=on \
#     docker compose --profile prod up -d

# Public hostname used by nginx and certbot.
# Set to your real domain for TLS; leave as "localhost" for local dev.
DOMAIN=localhost

# Email passed to Let's Encrypt during certificate issuance.
# Required only when TLS_MODE=on.
EMAIL=admin@localhost

# Set to "on" to enable HTTPS via certbot (requires a public DOMAIN).
# When "off" (default), nginx serves plain HTTP on port 80.
TLS_MODE=off

# Which AI backend serves chat: ollama (default, local) | openrouter (cloud
# API) | llamacpp (local llama.cpp llama-server). install.sh / install.ps1
# ask and write this for you.
AI_PROVIDER=ollama

# OpenRouter (AI_PROVIDER=openrouter). Get a key at https://openrouter.ai/keys.
# NOTE: with OpenRouter your chat content is sent to the cloud.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# llama.cpp (AI_PROVIDER=llamacpp). The Docker managed setup runs the internal
# `llamacpp` service (compose profile "llamacpp") serving LLAMACPP_MODEL_HF
# (llama-server -hf syntax - no hf.co/ prefix). Point LLAMACPP_URL at your own
# llama-server instead to skip the managed container. The bare-metal Windows
# launcher (start.ps1) uses http://127.0.0.1:8081 (LLAMACPP_PORT; 8080 would
# collide with JUN_PORT).
# LLAMACPP_URL=http://llamacpp:8080
# LLAMACPP_MODEL_HF=efficiencyx/Jun-LoRA-v3-E2B-GGUF:Q4_K_M

# RAG / cross-chat memory embeddings: on | off. They always run on Ollama's
# nomic-embed-text. Default: on when AI_PROVIDER=ollama, off otherwise. A
# non-Ollama provider can keep them by setting EMBEDDINGS=on and running
# Ollama alongside (the installers offer this); when off, the vector-memory
# features switch off silently and everything else works.
# EMBEDDINGS=on

# Compose profiles pick which model-server containers run. install.sh writes
# this; ./start.sh derives it from AI_PROVIDER when missing. Only needed if
# you run `docker compose up` directly:
#   ollama -> the ollama service        llamacpp -> the llama.cpp service
#   openrouter without embeddings -> leave empty
COMPOSE_PROFILES=ollama

# URL of the Ollama instance, as seen from inside the Docker network.
# Default points at the internal `ollama` service; override if you run
# Ollama on bare metal or a remote host. The bare-metal Windows launcher
# (start.ps1) ignores docker-internal hostnames like this one and talks to
# http://127.0.0.1:11434 instead.
OLLAMA_URL=http://ollama:11434

# Bare-metal Windows only: the port start.ps1 serves the web UI on.
# JUN_PORT=8080

# Comma-separated list of Ollama models pulled on first boot.
# Pulls are idempotent - restarts don't re-download cached weights.
# The first chat model is pre-warmed; keep nomic-embed-text (RAG embeddings).
# install.sh writes this for you. Its conservative defaults are:
#   4 GB: E2B Q4_K_M   6 GB: E2B Q6_K   8 GB: E4B Q4_K_M
#  10 GB: E4B Q6_K   12 GB: E4B Q8_0   16 GB: 12B Q6_K
# At each tier, the next listed quant (Q6_K, Q8_0, or 12B Q4_K_M) is also a
# suitable higher-quality choice when the rest of the workload leaves room.
OLLAMA_MODELS_TO_PULL=hf.co/efficiencyx/Jun-LoRA-v3-E2B-GGUF:Q4_K_M,nomic-embed-text

# Voice (TTS): "on" runs the Kokoro sidecar (the compose `voice` profile),
# "off" runs text-only. start.sh reads this to decide the profile.
VOICE=on

# Where the TTS sidecar runs torch: cpu | cuda | auto. "auto" uses the GPU only
# when the nvidia/amd overlay has built the sidecar against a GPU torch wheel
# (on the plain CPU build it stays on cpu). The models are tiny (~1 GB VRAM) but
# share the card with the LLM - set TTS_DEVICE=cpu to keep them off a tight GPU.
TTS_DEVICE=auto

# KV cache quantization (defaults set in docker-compose.yml). q8_0 halves KV
# memory at the 16k context with negligible quality loss; requires flash
# attention. Set OLLAMA_KV_CACHE_TYPE=f16 to opt out, or q4_0 to go smaller
# still (noticeable quality cost on long contexts).
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# URL of the Kokoro TTS sidecar, as seen from inside the Docker network.
KOKORO_URL=http://kokoro:8001

# Allowed CORS origin for the Kokoro FastAPI server.
# Should match the origin nginx is serving from (http://nginx internally).
CORS_ORIGIN=http://nginx
