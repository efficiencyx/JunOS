# Copy to .env. See docs/configuration.md for details.
DOMAIN=localhost

EMAIL=admin@localhost

TLS_MODE=off

AI_PROVIDER=ollama

# OpenRouter sends chat content to its cloud API.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# LLAMACPP_URL=http://llamacpp:8080
# LLAMACPP_MODEL_HF=efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M
# LLAMACPP_PORT=8081
# LLAMACPP_TOOLS=on

COMPOSE_PROFILES=ollama

OLLAMA_URL=http://ollama:11434

# JUN_PORT=8080

OLLAMA_MODELS_TO_PULL=hf.co/efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M

VOICE=on

# cuda works, but costs ~2GB VRAM for little synthesis speedup
TTS_DEVICE=cpu

STT_MODEL=base.en
STT_LANG=en

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# auto orders cards biggest-VRAM-first so the largest is device 0; a comma list
# (UUIDs or indices) picks specific cards; all leaves the driver's order alone.
# GPU_DEVICES=auto

# on splits one model across every GPU (ollama: OLLAMA_SCHED_SPREAD;
# llama.cpp on CUDA: --split-mode row). Slower per token, but fits more.
# TENSOR_PARALLEL=off

# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=5m

# Context window. Auto-detected from system RAM, which is only a proxy - VRAM is
# what bounds the KV cache. Set this by hand if the model crowds your GPU.
# OMEGA_NUM_CTX=8192

# OMEGA_STATE_DIR=/var/lib/omega
# MEMORY_DIR=/var/lib/omega/memory

# Anonymized chats & usage stats, used to train better versions of Jun.
# The installer asks; set off to opt out. Install id is generated by the installer.
TELEMETRY=on
TELEMETRY_INSTALL_ID=
# TELEMETRY_ENDPOINT=

TTS_URL=http://tts:8001

CORS_ORIGIN=http://nginx
