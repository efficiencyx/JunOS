# Copy to .env. See docs/configuration.md for details.
DOMAIN=localhost

EMAIL=admin@localhost

TLS_MODE=off

AI_PROVIDER=ollama

# OpenRouter sends chat content to its cloud API.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# LLAMACPP_URL=http://llamacpp:8080
# LLAMACPP_MODEL_HF=efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M
# LLAMACPP_PORT=8081
# LLAMACPP_TOOLS=on

# EMBEDDINGS=on
# EMBEDDINGS_URL=http://ollama:11434

COMPOSE_PROFILES=ollama

OLLAMA_URL=http://ollama:11434

# JUN_PORT=8080

OLLAMA_MODELS_TO_PULL=hf.co/efficiencyx/Jun-LoRA-v4-E2B-GGUF:Q4_K_M,nomic-embed-text

VOICE=on

TTS_DEVICE=auto

STT_MODEL=base.en
STT_LANG=en

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=5m

# OMEGA_STATE_DIR=/var/lib/omega
# MEMORY_DIR=/var/lib/omega/memory

TTS_URL=http://tts:8001

CORS_ORIGIN=http://nginx
