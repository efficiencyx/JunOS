# omega-tls.conf.template - HTTPS with certbot (TLS_MODE=on)
# Expanded by nginx 1.27 envsubst at container boot.

limit_req_zone  $binary_remote_addr zone=api:10m   rate=10r/s;
limit_conn_zone $binary_remote_addr zone=conns:10m;
limit_conn_status 429;

server {
    listen 80 default_server;
    server_name "";
    return 444;
}

# HTTP server for ACME challenges and HTTPS redirects.
server {
    listen 80;
    server_name ${DOMAIN};

    server_tokens off;

    # Let certbot webroot challenges through
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else goes to HTTPS
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name "";
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    return 444;
}

server {
    listen 443 ssl;
    http2  on;
    server_name ${DOMAIN};

    server_tokens off;

    gzip            on;
    gzip_vary       on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types      text/css application/javascript application/json image/svg+xml text/plain;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_session_cache   shared:SSL:10m;

    root  /var/www/omega;
    index index.html;

    client_max_body_size 16k;

    # A literal host in fastcgi_pass is resolved once at config load and cached
    # forever, so a php container that restarts onto a new IP leaves nginx
    # dialling the old one (which docker may have reassigned) until nginx itself
    # is restarted. Going through a variable defers resolution to request time.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $php_upstream php:9000;

    add_header Strict-Transport-Security  "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;

    location = /health {
        default_type text/plain;
        return 200 "ok";
    }

    # Buffering and compression must remain off for incremental SSE: gzip
    # collects the response into its own buffer, which stalls the token stream.
    location = /api/chat.php {
        limit_req zone=api burst=20 nodelay;
        limit_conn conns 2;
        # A spoken turn ships the wav base64'd in the JSON body: 30s of 16kHz
        # mono PCM16 is ~960KB, ~1.3MB once encoded, and the history rides
        # along with it. PHP's post_max_size is already 30M, so this is the
        # limit that decides.
        client_max_body_size 4m;

        gzip                off;
        proxy_buffering     off;
        fastcgi_buffering   off;
        fastcgi_read_timeout 600s;
        fastcgi_keep_conn   on;

        add_header X-Accel-Buffering no always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/security-headers.conf;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega/api/chat.php;
        fastcgi_pass  $php_upstream;
    }

    location = /api/tts.php {
        limit_req zone=api burst=10 nodelay;
        client_max_body_size 16k;

        gzip off;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega/api/tts.php;
        fastcgi_pass  $php_upstream;
    }

    # Accept the larger WAV upload body. keep it in step with PHP's
    # post_max_size, STT_MAX_BYTES in tts/server.py, and the chat.php limit
    # above, an utterance goes to one or the other.
    location = /api/stt.php {
        limit_req zone=api burst=5 nodelay;
        limit_conn conns 1;
        client_max_body_size 4m;
        fastcgi_read_timeout 60s;

        gzip off;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega/api/stt.php;
        fastcgi_pass  $php_upstream;
    }

    # Karaoke: large audio upload for source separation + a long demucs runtime.
    location = /api/karaoke.php {
        limit_req zone=api burst=5 nodelay;
        limit_conn conns 1;
        client_max_body_size 30m;
        fastcgi_read_timeout 300s;

        gzip off;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega/api/karaoke.php;
        fastcgi_pass  $php_upstream;
    }

    # CLI-only long-running worker; it must never be reachable over HTTP.
    location = /api/consolidation-worker.php { return 404; }
    location = /system_prompt.txt { return 404; }
    location ^~ /api/migrations/ { return 404; }
    location ~ (^|/)\. { return 404; }

    location ~ ^/api/.+\.php$ {
        limit_req zone=api burst=10;
        client_max_body_size 16k;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega$fastcgi_script_name;
        fastcgi_pass  $php_upstream;
    }

    # Prevent direct PHP access outside /api.
    location ~ \.php$ { return 404; }

    # The document must stay revalidated, otherwise the ?v= bumps below it
    # would themselves be cached and never seen.
    location = /index.html {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /assets/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/omega/api/assets.php;
        fastcgi_param OMEGA_ASSET_PATH $uri;
        fastcgi_param OMEGA_X_ACCEL 1;
        fastcgi_pass $php_upstream;
    }

    location ^~ /_omega_assets/ {
        internal;
        alias /var/www/omega/assets/;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "private, max-age=31536000, immutable" always;
        add_header Vary Cookie always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Every asset reference carries a ?v=N, so a changed file is a changed URL.
    location ~* \.(js|css|png|jpe?g|gif|ico|svg|webp|webm|mp4|wasm|woff2?|ttf|otf)$ {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
