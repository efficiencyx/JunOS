# the bare metal Windows install, portable PHP, the TTS venv,
# models, chat, logs
runtime/

Junk/

# game-ripped Live2D assets, rebuilt with tools/recover_assets.py.
# personal use only, NEVER redistribute (see the NOTICE in LICENSE).
webapp/assets/

# generated library cache (unsloth) - don't commit
unsloth_compiled_cache/

# dataset generation tools
tools/dataset_v5
tools/dataset_v6

# LoRA training pipeline and its debug scratch - operates on the
# gitignored dataset dirs, nothing in the running stack imports
# it. Not to be confused with colab.ipynb, which serves the app
# and stays tracked.
train_jun.py
train_think_colab.ipynb
tools/build_dataset_v6.py
diag_labels.py
diag_thinking.py
smoke_thinking.py
from_think_tags.py
# review.php is tracked here; the line only matters once this file is
# copied to the public tree, where a stale local copy must stay ignored.
webapp/api/review.php
webapp/api/review.js

# raw Live2D source assets - kept locally, not in the repo
live2d_raw/

# lore dataset and the corpus built from it by build_lore_index.php.
# the jsonl is tracked here but publish.sh keeps it out of the public
# tree; this line is what stops it being re-added over there.
tools/lore_dataset.jsonl
# (.bin/.json came from the embedding index, deleted in 2026-07;
# still ignored so stale copies in older checkouts never get
# committed)
webapp/lore_corpus.txt
webapp/lore_index.bin
webapp/lore_meta.json


# deploy state (created at runtime)
/data/
letsencrypt/

# local .env snapshots kept while switching backends
.env.bak-*

# local render rig for clothing shots - opens the shipped webapp
# assets, not something a user needs
tools/clothing-render.html
tools/clothing-render.js

# build output from tools/build-installer-exe.ps1
dist/


# the promo reels, landscape and vertical. both drive the real
# rig off the real webapp/assets/, so they only run on a machine
# that already has them - nothing to ship to a user, and nothing
# that would survive a fresh clone anyway. the audio and the mod
# tiles under them are generated too, out of material that is
# itself gitignored.
webapp/showcase.html
webapp/showcase.css
webapp/js/showcase.js
webapp/showcase-audio/
webapp/showcase-mod/
webapp/showcase-tiktok.html
webapp/showcase-tiktok.css
webapp/js/showcase-tiktok.js
