# env / secrets
.env
.env.local

# python
__pycache__/
*.pyc
.venv/
tts/.venv/

# editor / OS / tooling
.idea/
.vscode/
.DS_Store
*~

# build / runtime
node_modules/
*.log

# bare-metal Windows install (portable PHP, TTS venv, models, chat state, logs)
runtime/

# project-specific
Junk/

# Game-ripped Live2D assets - rebuilt locally with tools/recover_assets.py,
# NOT redistributed with this repo (see the NOTICE in LICENSE). Kept out of
# git so a fork can't accidentally republish them.
webapp/assets/

# generated library cache (unsloth) - don't commit
unsloth_compiled_cache/

# raw Live2D source assets - kept locally, not in the repo
live2d_raw/

# lore corpus - generated from tools/lore_dataset.jsonl by build_lore_index.php
# (.bin/.json came from the embedding index, deleted in 2026-07; still ignored so
# stale copies in older checkouts never get committed)
webapp/lore_corpus.txt
webapp/lore_index.bin
webapp/lore_meta.json

# extracted game dialogue - personal-use only per LICENSE NOTICE, kept local
tools/dataset_v5/raw_game_text/
tools/dataset_v5/dialogue_all.jsonl
tools/dataset_v5/jun_style_corpus.jsonl
tools/dataset_v5/style_corpus.jsonl
tools/dataset_v5/verbatim_seed.jsonl

# V5 training data - generated dialogue + verbatim game seed rows, kept local
tools/dataset_v5/content/
tools/dataset_v5/out/

# deploy state (created at runtime)
data/
letsencrypt/

# local .env snapshots kept while switching backends
.env.bak-*

# built from the extracted game dialogue - same reason as dataset_v5/out/
tools/dataset_v6/train.jsonl
